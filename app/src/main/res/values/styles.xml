<?xml version="1.0" encoding="utf-8"?>
<resources>



    <style name="spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:ellipsize">none</item>
        <item name="android:dropDownVerticalOffset">18dp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="spinner_item" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:ellipsize">none</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="spinner_style" parent="Widget.AppCompat.ListView.DropDown">
        <item name="android:dividerHeight">1px</item>
        <item name="android:scrollbars">none</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="spinner_dropdown_item_style" parent="Widget.AppCompat.DropDownItem.Spinner">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- Custom style for the Toolbar Title -->
    <style name="ToolbarTitleTextAppearance" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item> <!-- Set your desired font size here -->
        <!-- <item name="android:textColor">@color/your_title_color</item> -->
         <item name="android:fontFamily">sans-serif-condensed-medium</item>
    </style>

    <style name="CustomToolbarStyle" parent="Widget.AppCompat.Toolbar">
        <item name="titleTextAppearance">@style/ToolbarTitleTextAppearance</item>
<!--        <item name="subtitleTextAppearance">@style/ToolbarSubtitleTextAppearance</item> &lt;!&ndash; If you use subtitles &ndash;&gt;-->
    </style>

</resources>